        "remove": {
          "component_groups": [
            "three_realms:phase1",
            "three_realms:phase2",
            "three_realms:phase3"
          ]
        },
        "add": {
          "component_groups": [
            "three_realms:death_state"
          ]
        },
        "run_command": {
          "command": [
            "playsound three_realms.morgue_warden.attack @a ~ ~ ~ 0.40 0.35 0.06",
            "scoreboard players set @p three_realms.morgue_warden_killed 1"
          ]
        }
      }
