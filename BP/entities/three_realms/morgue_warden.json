          "command": [
            "playsound three_realms.morgue_warden.breath @a ~ ~ ~ 0.32 0.45 0.04"
          ]
        }
      },
      "three_realms:on_hurt": {
        "sequence": [
          {
            "filters": {
              "test": "has_component",
              "subject": "self",
              "operator": "not",
              "value": "minecraft:variant"
            },
            "add": { "component_groups": [ "three_realms:phase1" ] }
          },
          {
            "filters": {
              "all_of": [
                { "test": "is_mark_variant", "subject": "self", "value": 0 },
                { "test": "has_damage", "subject": "self", "operator": ">=", "value": 70 }
              ]
            },
            "remove": { "component_groups": [ "three_realms:phase1" ] },
            "add": { "component_groups": [ "three_realms:phase2" ] }
          },
          {
            "filters": {
              "all_of": [
                { "test": "is_mark_variant", "subject": "self", "value": 1 },
                { "test": "has_damage", "subject": "self", "operator": ">=", "value": 150 }
              ]
            },
            "remove": { "component_groups": [ "three_realms:phase2" ] },
            "add": { "component_groups": [ "three_realms:phase3" ] }
          },
          {
            "run_command": {
              "command": [
                "playsound three_realms.morgue_warden.breath @a ~ ~ ~ 0.35 0.55 0.05"
              ]
            }
          }
        ]
      },
