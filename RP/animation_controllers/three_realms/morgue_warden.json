{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.three_realms.morgue_warden": {
      "initial_state": "phase1_idle",
      "states": {
        "phase1_idle": {
          "transitions": [
            { "walk": "query.modified_move_speed > 0.1" },
            { "attack": "query.is_delayed_attacking" },
            { "hurt": "query.hurt_time > 0" },
            { "death": "query.health <= 0" },
            { "phase2": "query.mark_variant == 1" },
            { "phase3": "query.mark_variant == 2" }
          ],
          "animations": [
            "idle",
            "breathing",
            "head"
          ]
        },
        "walk": {
          "transitions": [
            { "phase1_idle": "query.modified_move_speed <= 0.1" },
            { "attack": "query.is_delayed_attacking" },
            { "hurt": "query.hurt_time > 0" },
            { "death": "query.health <= 0" },
            { "phase2": "query.mark_variant == 1" },
            { "phase3": "query.mark_variant == 2" }
          ],
          "animations": [
            "walk",
            "breathing"
          ]
        },
        "attack": {
          "transitions": [
            { "phase1_idle": "query.all_animations_finished" },
            { "walk": "query.all_animations_finished" },
            { "death": "query.health <= 0" }
          ],
          "animations": [
            "attack"
          ]
        },
        "hurt": {
          "transitions": [
            { "phase1_idle": "query.hurt_time <= 0" },
            { "death": "query.health <= 0" }
          ],
          "animations": [
            "hurt"
          ]
        },
        "phase2": {
          "transitions": [
            { "walk": "query.modified_move_speed > 0.1" },
            { "attack": "query.is_delayed_attacking" },
            { "hurt": "query.hurt_time > 0" },
            { "death": "query.health <= 0" },
            { "phase1_idle": "query.mark_variant == 0" },
            { "phase3": "query.mark_variant == 2" }
          ],
          "animations": [
            "stalking",
            "breathing"
          ]
        },
        "phase3": {
          "transitions": [
            { "walk": "query.modified_move_speed > 0.1" },
            { "attack": "query.is_delayed_attacking" },
            { "hurt": "query.hurt_time > 0" },
            { "death": "query.health <= 0" },
            { "phase1_idle": "query.mark_variant == 0" },
            { "phase2": "query.mark_variant == 1" }
          ],
          "animations": [
            "enraged",
            "breathing"
          ]
        },
        "death": {
          "transitions": [],
          "animations": [
            "death"
          ]
        }
      }
    }
  }
}