{
  "format_version": "1.26.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "three_realms:scp5167_dragon_shot",
      "materials": {
        "default": "arrow"
      },
      "textures": {
        "default": "textures/entity/dt_scp5167_dragon_shot"
      },
      "geometry": {
        "default": "geometry.three_realms.dt_scp5167_dragon_shot"
      },
      "animations": {
        "move": "animation.three_realms.arrow.move"
      },
      "particle_effects": {
        "charged_flames": "minecraft:mobflame_emitter"
      },
      "scripts": {
        "pre_animation": [
          "variable.shake = query.shake_time - query.frame_alpha;",
          "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;"
        ],
        "animate": [
          "move"
        ]
      },
      "render_controllers": [
        "controller.render.three_realms.arrow"
      ]
    }
  }
}
